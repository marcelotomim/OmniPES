within OmniPES;

package Icons
  extends Modelica.Icons.IconsPackage;
  annotation(Documentation(info="<html>
<body>
<h4>Overview</h4>
<p>
The <strong>Icons</strong> subpackage contains graphical icon definitions for visual representation of power system components in Modelica tools. These icons provide standardized visual elements that improve model readability and user experience in the diagram view.
</p>

<h4>Usage</h4>
<p>
Icon models are used internally by component models to define their graphical appearance. Users generally do not interact with these models directly, but they ensure consistent visual representation across the OmniPES library.
</p>
</body>
</html>"),
    Icon(coordinateSystem(extent = {{-100, -100}, {100, 80}})));
end Icons;