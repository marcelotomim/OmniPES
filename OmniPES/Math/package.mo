within OmniPES;

package Math
  extends Modelica.Icons.FunctionsPackage;
  annotation(
    Documentation(info="<html>
<head></head>
<body>
  <h4>Overview</h4>
  <p>
    The <code>Math</code> package provides utility functions for mathematical operations commonly used in power system modeling.
    These functions support coordinate transformations, nonlinear mappings, and other specialized calculations required by the OmniPES library.
  </p>

  <h4>Usage</h4>
  <p>
    Math functions are primarily called internally by other OmniPES components but can also be used directly in custom models.
  </p>
</body>
</html>"));
end Math;