within OmniPES;

package Scopes
  annotation(
    Documentation(info="<html>
<head></head>
<body>
  <h4>Overview</h4>
  <p>
    The <code>Scopes</code> package provides measurement and visualization instruments for monitoring electrical quantities in power system models.
    These components extract quantities of interest from the network without affecting the system dynamics.
  </p>

  <h4>Usage</h4>
  <p>
    Connect scope instruments accordingly to monitor system quantities during simulation.
    Output signals can be visualized using Modelica plotting tools or exported for post-processing.
  </p>
</body>
</html>"));
end Scopes;