within OmniPES.SteadyState.Loads;

package Interfaces "Interfaces for steady-state load models"
  extends Modelica.Icons.InterfacesPackage;

  annotation (Documentation(info="<html>
<p>
This package provides partial models and data records that define the interfaces
for steady-state load models in the OmniPES library.
</p>

<h4>Interface Elements</h4>
<ul>
<li><a href=\"modelica://OmniPES.SteadyState.Loads.Interfaces.LoadData\">LoadData</a> –
Data record defining steady-state load parameters</li>
<li><a href=\"modelica://OmniPES.SteadyState.Loads.Interfaces.Partial_Load\">Partial_Load</a> –
Partial base model for steady-state load implementations</li>
</ul>
</html>"));
end Interfaces;