within OmniPES.SteadyState;

package Loads "Steady-state load models"
  extends Modelica.Icons.Package;

  annotation (Documentation(info="<html>
<p>
This package provides steady-state load models for phasor-domain simulations in the OmniPES library.
</p>

<h4>Available Components</h4>
<ul>
<li><a href=\"modelica://OmniPES.SteadyState.Loads.Interfaces\">Interfaces</a> –
Base partial models and data records for steady-state loads</li>
<li><a href=\"modelica://OmniPES.SteadyState.Loads.ZIPLoad\">ZIPLoad</a> –
ZIP (constant impedance, current, and power) load model</li>
</ul>
</html>"));
end Loads;