within OmniPES.Circuit.Switches;

package Interfaces "Base interfaces for electrical switching devices"
  extends Modelica.Icons.InterfacesPackage;
  
  annotation (Documentation(info="<html>
<p>
This package contains partial models and base interfaces for electrical switching 
devices in the OmniPES library.
</p>

<h4>Partial Models</h4>
<p>
The following partial model provides the base implementation for switching devices:
</p>
<ul>
<li><a href=\"modelica://OmniPES.Circuit.Switches.Interfaces.BasicBreaker\">BasicBreaker</a> - 
Base model for circuit breakers and switching devices</li>
</ul>
</html>"));
end Interfaces;