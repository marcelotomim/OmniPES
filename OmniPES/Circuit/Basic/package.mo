within OmniPES.Circuit;

package Basic "Basic electrical circuit components"
  extends Modelica.Icons.Package;
  
  annotation (Documentation(info="<html>
<p>
This package contains models of basic electrical circuit components 
in the OmniPES library.
</p>

<h4>Available Components</h4>
<p>
The following basic electrical components are available:
</p>
<ul>
<li><a href=\"modelica://OmniPES.Circuit.Basic.SeriesImpedance\">SeriesImpedance</a> - 
Series impedance component</li>
<li><a href=\"modelica://OmniPES.Circuit.Basic.SeriesAdmittance\">SeriesAdmittance</a> - 
Series admittance component</li>
<li><a href=\"modelica://OmniPES.Circuit.Basic.ShuntAdmittance\">ShuntAdmittance</a> - 
Shunt admittance component</li>
<li><a href=\"modelica://OmniPES.Circuit.Basic.ShuntImpedance\">ShuntImpedance</a> - 
Shunt impedance component</li>
<li><a href=\"modelica://OmniPES.Circuit.Basic.Shunt_Reactor\">Shunt_Reactor</a> - 
Shunt reactor for reactive power compensation</li>
<li><a href=\"modelica://OmniPES.Circuit.Basic.Shunt_Capacitor\">Shunt_Capacitor</a> - 
Shunt capacitor for reactive power compensation</li>
<li><a href=\"modelica://OmniPES.Circuit.Basic.TLine\">TLine</a> - 
Transmission line model</li>
<li><a href=\"modelica://OmniPES.Circuit.Basic.TLine_switched\">TLine_switched</a> - 
Switchable transmission line model</li>
<li><a href=\"modelica://OmniPES.Circuit.Basic.SeriesImpedance_switched\">SeriesImpedance_switched</a> - 
Switchable series impedance component</li>
<li><a href=\"modelica://OmniPES.Circuit.Basic.TwoWindingTransformer\">TwoWindingTransformer</a> - 
Two-winding transformer</li>
<li><a href=\"modelica://OmniPES.Circuit.Basic.Ground\">Ground</a> - 
Ground reference node</li>
</ul>
</html>"));
end Basic;